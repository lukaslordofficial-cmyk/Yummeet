{
  "expo": {
    "name": "Yummeet",
    "slug": "yummeet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yummeet",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100E0C",
    "androidNavigationBar": {
      "backgroundColor": "#100E0C",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yummeet.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pokaż lokale w pobliżu, Gastro-Trasę i pojedynki",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Śledź Gastro-Trasę i powiadamiaj o knajpach także gdy aplikacja jest w tle",
        "UIBackgroundModes": [
          "location"
        ],
        "LSApplicationQueriesSchemes": [
          "tel",
          "wolt",
          "glovo",
          "glovoapp",
          "pysznepl",
          "ubereats",
          "http",
          "https"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.yummeet.app",
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#100E0C"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/*", "text/plain", "text/uri-list"],
            "multipleShareMimeTypes": []
          }
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pokaż lokale w pobliżu, trasy i pojedynki",
          "locationAlwaysAndWhenInUsePermission": "Śledź Gastro-Trasę i powiadamiaj o knajpach także w tle",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dodaj zdjęcie lokalu do pinu",
          "cameraPermission": "Zrób zdjęcie lokalu do pinu"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e60356be-d339-4ff3-b95a-24794b6c8c5e"
      }
    },
    "owner": "ciachodlatutu"
  }
}
