{
  "expo": {
    "name": "Yummeet",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.yummeetpreview.td2o84",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pokaż lokale w pobliżu, Gastro-Trasę i pojedynki",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Śledź Gastro-Trasę i powiadamiaj o knajpach także gdy aplikacja jest w tle",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.yummeetpreview.td2o84",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pokaż lokale w pobliżu, trasy i pojedynki",
          "locationAlwaysAndWhenInUsePermission": "Śledź Gastro-Trasę i powiadamiaj o knajpach także w tle",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dodaj zdjęcie lokalu do pinu",
          "cameraPermission": "Zrób zdjęcie lokalu do pinu"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}